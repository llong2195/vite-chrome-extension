{
  "name": "vite-chrome-extension",
  "version": "1.0.0",
  "description": "Production-ready Chrome extension template with Vite, React, and TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "build:analyze": "vite build --mode analyze"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llong2195/vite-chrome-extension.git"
  },
  "keywords": [
    "chrome-extension",
    "vite",
    "react",
    "typescript",
    "manifest-v3"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/llong2195/vite-chrome-extension/issues"
  },
  "homepage": "https://github.com/llong2195/vite-chrome-extension#readme",
  "dependencies": {
    "@types/chrome": "^0.1.32",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.15",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.0.11",
    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "vitest": "^4.0.15"
  }
}
