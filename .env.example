# Environment Variables Example
# Copy this file to .env for local development
# DO NOT commit .env to version control

# Development Mode
# NODE_ENV=development

# Extension Configuration
# VITE_EXTENSION_NAME="My Chrome Extension"
# VITE_EXTENSION_VERSION="1.0.0"

# API Configuration (if your extension uses external APIs)
# VITE_API_URL=https://api.example.com
# VITE_API_KEY=your_api_key_here

# Feature Flags
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG_LOGS=false

# Chrome Web Store (for publishing)
# CHROME_CLIENT_ID=your_client_id
# CHROME_CLIENT_SECRET=your_client_secret
# CHROME_REFRESH_TOKEN=your_refresh_token
# CHROME_EXTENSION_ID=your_extension_id

# Note: All VITE_* variables will be available in your extension code via import.meta.env
# Example: const apiUrl = import.meta.env.VITE_API_URL
